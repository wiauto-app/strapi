{
  "kind": "collectionType",
  "collectionName": "noticias",
  "info": {
    "singularName": "noticia",
    "pluralName": "noticias",
    "displayName": "noticia"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo"
    },
    "contenido": {
      "type": "blocks",
      "required": true
    },
    "resumen": {
      "type": "text",
      "required": true
    },
    "banner": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "categoria_noticia": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::categoria-noticia.categoria-noticia"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "publicado_por": {
      "type": "component",
      "component": "shared.user",
      "repeatable": false
    },
    "comentarios": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comentario.comentario"
    },
    "citacion": {
      "type": "text"
    },
    "destacada": {
      "type": "boolean"
    }
  }
}
