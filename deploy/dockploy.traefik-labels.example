# Labels Traefik manuales (opcional).
# En Dockploy lo recomendado es usar la pestaña Domains de la UI:
#   service → strapi | port → 1337 | domain → strapi.wiauto.es
#
# Si prefieres labels en el compose, añádelos al servicio strapi:
#
# labels:
#   - traefik.enable=true
#   - traefik.docker.network=dokploy-network
#   - traefik.http.routers.strapi-wiauto.rule=Host(`strapi.wiauto.es`)
#   - traefik.http.routers.strapi-wiauto.entrypoints=websecure
#   - traefik.http.routers.strapi-wiauto.tls.certresolver=letsencrypt
#   - traefik.http.services.strapi-wiauto.loadbalancer.server.port=1337
