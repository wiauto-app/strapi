
# Server
HOST=0.0.0.0
PORT=1337
NODE_ENV=production

# URL pública (Dockploy + Traefik terminan HTTPS). Sin :1337
PUBLIC_URL=https://strapi.wiauto.es
STRAPI_ADMIN_BACKEND_URL=https://strapi.wiauto.es
SERVER_PROXY=true

# Orígenes permitidos para CORS (frontend)
CORS_ORIGINS=https://wiauto.es,https://www.wiauto.es,http://localhost:3000

# Secrets
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=

# Database (strapiDB es el hostname interno del compose)
DATABASE_CLIENT=postgres
DATABASE_HOST=strapiDB
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SCHEMA=public
